# Copy this file to ml/.env and fill in the values. Never commit ml/.env.

# Claude API key (needed for Claude models)
ANTHROPIC_API_KEY=

# Google Gemini API key (needed for Gemini models)
GEMINI_API_KEY=

# Model that classifies pages: 

# claude-haiku-5-5 (cheap, default), 
# claude-sonnet-5-5 (best, ~10x the price),

# a free models: 
# local:gemma-4-12b-it 
# local:qwen3.5-9b
# gemini:gemini-3.6-flash 

# Restart after changing: docker compose restart ml

CLASSIFIER_MODEL=gemini:gemini-3-flash-preview

# Hugging Face token, only needed for the private translation model
HF_TOKEN=
