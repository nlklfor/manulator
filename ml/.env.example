# Copy this file to ml/.env and fill in the values. Never commit ml/.env.

# Claude API key (needed for Claude models)
ANTHROPIC_API_KEY=

# Google Gemini API key (needed for Gemini models)
GEMINI_API_KEY=

# Model that classifies pages: claude-haiku-5-5 (cheap, default), claude-sonnet-5-5 (best, ~10x the price),
# gemini:<model> (e.g. gemini:gemini-3.5-flash),
# or a free model on our GPU: local:gemma-4-12b-it or local:qwen3.5-9b (needs the llama-server container
# started with that model, see ml/eval/README.md). Restart after changing: docker compose restart ml
CLASSIFIER_MODEL=claude-haiku-5-5

# Hugging Face token, only needed for the private translation model
HF_TOKEN=
